#. Plugin Name of the plugin
#: hourspilot.php
msgid "HoursPilot"
msgstr "HoursPilot"

#. Plugin URI of the plugin
#: hourspilot.php
msgid "https://github.com/TSA3000/hourspilot"
msgstr "https://github.com/TSA3000/hourspilot"

#. Description of the plugin
#: hourspilot.php
msgid "Business hours, holidays and live open/closed status for one or more locations. Shortcode, cache-friendly, schema.org markup."
msgstr "Öppettider, helgdagar och live-status öppet/stängt för en eller flera platser. Kortkod, cachevänlig, schema.org-märkning."

#. Author of the plugin
#: hourspilot.php
msgid "Arthur Sam Mahdi"
msgstr "Arthur Sam Mahdi"

#. Author URI of the plugin
