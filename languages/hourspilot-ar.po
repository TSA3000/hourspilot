#. Plugin Name of the plugin
#: hourspilot.php
msgid "HoursPilot"
msgstr "HoursPilot"

#. Plugin URI of the plugin
#: hourspilot.php
msgid "https://github.com/TSA3000/hourspilot"
msgstr "https://github.com/TSA3000/hourspilot"

#. Description of the plugin
#: hourspilot.php
msgid "Business hours, holidays and live open/closed status for one or more locations. Shortcode, cache-friendly, schema.org markup."
msgstr "ساعات العمل والعطلات وحالة مفتوح/مغلق المباشرة لموقع واحد أو أكثر. رمز قصير، متوافق مع التخزين المؤقت، وبيانات schema.org المنظمة."

